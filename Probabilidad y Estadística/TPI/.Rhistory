library(readxl)
head(datos)
library(readxl)
datos <- read_excel("/Users/aresito/Universidad/Probabilidad y Estadística/TPI/TUPAD-2025-EST-TPI-planilla1.xlsx")
head(datos)
summary(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`)
nclass.Sturges(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`)
breaks <- seq(1, 22, by = 3)
intervalos <- cut(datos$`TIEMPO SEMANAL en HS. DEDIC. EST.`, breaks = breaks, right = FALSE)
tabla <- table(intervalos)
tabla
fi <- as.vector(tabla)           # absolute frequency
Fi <- cumsum(fi)                 # cumulative absolute frequency
ri <- fi / sum(fi)               # relative frequency
Ri <- cumsum(ri)                 # cumulative relative frequency
tabla_frecuencias <- data.frame(
intervalo = names(tabla),
fi = fi,
Fi = Fi,
ri = round(ri, 4),
Ri = round(Ri, 4)
)
tabla_frecuencias
table(datos$`SATISFACCIÓN CON LA CARRERA`)
table(datos$`SATISFACCIÓN CON LA CARRERA`)
satisfaccion <- datos$`SATISFACCIÓN CON LA CARRERA`
fi_s <- as.vector(table(satisfaccion))
Fi_s <- cumsum(fi_s)
ri_s <- fi_s / sum(fi_s)
Ri_s <- cumsum(ri_s)
tabla_satisfaccion <- data.frame(
categoria = c("Muy Insatisfecho", "Insatisfecho", "Satisfecho", "Muy Satisfecho"),  fi = fi_s,
Fi = Fi_s,
ri = round(ri_s, 4),
Ri = round(Ri_s, 4)
)
tabla_satisfaccion
tabla_frecuencias
