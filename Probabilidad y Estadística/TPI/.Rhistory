col = "steelblue",
border = "white")
# ── Tarea 4b: Diagrama circular - Nivel de satisfacción ──────────────────────
tabla_sat <- table(satisfaccion)
porcentajes <- round(prop.table(tabla_sat) * 100, 1)
etiquetas <- c("Insatisfecho", "Poco satisfecho", "Satisfecho", "Muy satisfecho")
etiquetas_completas <- paste(etiquetas, porcentajes, "%")
pie(tabla_sat,
labels = etiquetas_completas,
main = "Nivel de satisfacción con la carrera",
col = c("tomato", "orange", "steelblue", "seagreen"))
